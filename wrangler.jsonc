{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veckans-fynd",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  // Create with: npx wrangler kv namespace create DEALS_KV
  "kv_namespaces": [
    {
      "binding": "DEALS_KV",
      "id": "replace-after-kv-namespace-create"
    }
  ],
  "triggers": {
    // Every 6 hours UTC — hits the same refresh path as GET /api/cron/refresh
    "crons": ["0 */6 * * *"]
  }
}
