{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veckans-fynd",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "veckans-fynd"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "DEALS_KV"
    }
  ],
  "triggers": {
    // Every 6 hours UTC — pair with GET /api/cron/refresh once a scheduled handler is wired
    "crons": ["0 */6 * * *"]
  }
}
